# The Interview Mentor AI — Configuration Template
APP_NAME="The Interview Mentor AI"
HOST=127.0.0.1
PORT=8060
BASE_PATH=/interview

# Security & Authentication
SECRET_KEY=generate-a-secure-random-secret-key-for-jwt-signing
INTERVIEW_PASSWORD=ChangeThisPassword123!
INTERVIEW_ALT_PASSWORD=
ACCESS_TOKEN_EXPIRE_DAYS=30

# Google Gemini API (Only Google Gemini keys are supported)
GEMINI_API_KEY=your_google_gemini_api_key_here
DEFAULT_GEMINI_MODEL=gemini-pro-latest
FAST_GEMINI_MODEL=gemini-flash-lite-latest
PREVIEW_GEMINI_MODEL=gemini-3.1-pro-preview

# Paths
AGENTS_DIR=/opt/interview-mentor/agents
DB_PATH=/opt/interview-mentor/interview_mentor.db
